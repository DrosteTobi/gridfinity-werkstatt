# Owner notification target (never invent a real mailbox — set this in hosting secrets)
ORDER_NOTIFY_EMAIL=

# Optional POST webhook for new orders (JSON body)
# ORDER_WEBHOOK_URL=https://example.com/hooks/orders

# Protects GET /api/orders and the admin UI unlock (required; no default)
ADMIN_TOKEN=

# Set automatically by Cursor apps hosting when database is enabled
# DATABASE_URL=
